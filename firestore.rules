rules_version = '2';
// Only the shared register account (the one whose password is the PIN)
// can read or change anything. Everyone else gets nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'register@mojodojo.app';
    }
  }
}
